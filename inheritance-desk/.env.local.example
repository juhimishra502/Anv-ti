# Inheritance Desk — environment configuration
# Copy to .env.local and fill in what you have. Nothing here is required to run the
# Milestone 1 demo; missing keys degrade to honest "unavailable" states, never fakes.

# --- AI assistant (grounded chatbot) — Groq ---
# When set, the chat route calls Groq (server-side only) and grounds answers ONLY in
# retrieved, source-cited procedures. When unset, the chatbot shows an honest
# unavailable state (it never invents a scripted "working" reply). The key is read on
# the server and is never exposed to the browser.
GROQ_API_KEY=
# Optional model override. Defaults to openai/gpt-oss-120b.
# Availability depends on your Groq account/tier — check GET /v1/models. Common chat
# models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b, groq/compound
# (see console.groq.com/docs/models). Whisper (whisper-large-v3) is available for STT.
GROQ_MODEL=openai/gpt-oss-120b

# --- Session signing ---
# Used to sign the demo session cookie (HMAC). A random value is generated at runtime
# if unset, but set a stable secret so sessions survive a server restart.
SESSION_SECRET=

# --- Aadhaar authentication ---
# Which provider the sign-in flow uses. Defaults to "sandbox" (synthetic test
# identities; NOT real verification). "live" requires an authorized UIDAI provider
# (AUA/KUA via an ASA) and the credentials below — without them, live stays DISABLED.
AADHAAR_PROVIDER=sandbox
# AADHAAR_AUA_CODE=
# AADHAAR_ASA_KEY=
# AADHAAR_LICENSE_KEY=

# --- Speech (optional, configurable) ---
# Voice uses the browser Web Speech API by default. To route STT to Groq Whisper
# server-side later, wire NEXT_PUBLIC_STT_PROVIDER (not required for the browser path).
# NEXT_PUBLIC_STT_PROVIDER=

# --- Milestone 2 (not used yet) ---
# Postgres/Supabase replaces the local node:sqlite database in Milestone 2.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
